```{r}
# --- 1. CONFIGURATION ---
library(tidyverse)
library(gtsummary)
library(flextable)
library(officer)

# Lecture
df <- read_csv2("data_odonto_all.csv", locale = locale(encoding = "Latin1"))

# --- 2. PRÉPARATION ---
df_analyse <- df %>%
  mutate(
    # Groupe Etude : On garde "Autre" explicitement
    # (Pas de correction Strasbourg ici, comme demandé)
    groupe_etude = case_when(
      str_detect(origin_study, "PACES") ~ "PACES",
      str_detect(origin_study, "PASS") ~ "PASS",
      str_detect(origin_study, "LAS") ~ "LAS",
      str_detect(origin_study, "Passerelle") ~ "Passerelle",
      TRUE ~ "Autre" # Ces 5 étudiants sont gardés
    ),
    
    # --- VARIABLES CONTINUES ---
    Score_JSE = {
      i_inv <- paste0("J", c(1, 3, 6, 7, 8, 11, 12, 14, 18, 19))
      i_norm <- paste0("J", c(2, 4, 5, 9, 10, 13, 15, 16, 17, 20))
      d_temp <- select(., all_of(c(i_inv, i_norm))) %>% mutate(across(everything(), as.numeric))
      raw_score <- rowSums(8 - d_temp[i_inv], na.rm = TRUE) + rowSums(d_temp[i_norm], na.rm = TRUE)
      raw_score - 20 # Calibration -20
    },
    PT = rowSums(select(., paste0("J", c(2,4,5,9,10,13,15,16,17,20))) %>% mutate(across(everything(), as.numeric)), na.rm=TRUE),
    CC = {
       q_bin <- select(., c(starts_with("cc_Q11"), starts_with("cc_Q17"), "cc_Q13", "cc_Q14b", "cc_Q14c", "cc_Q14d", "cc_Q14e"))
       q_val <- select(., c("cc_Q18a", "cc_Q18b", "cc_Q18c"))
       rowSums(q_bin, na.rm=TRUE) + rowSums(q_val, na.rm=TRUE)
    },
    SPS = as.numeric(J16),
    stated_risk = as.numeric(stated_risk),
    stated_altruism = as.numeric(stated_altruism),
    stated_patience = as.numeric(stated_patience),
    risk_health_other = as.numeric(risk_health_other),
    risk_self = as.numeric(BRET_self),
    risk_else = as.numeric(BRET_other),
    pg = as.numeric(PG),
    altruist_cg = risk_self - risk_else,

    # --- VARIABLES BINAIRES ---
    CG_conform = case_when(CG_X == "A" & CG_Y == "B" ~ 1, TRUE ~ 0),
    Homme = case_when(str_detect(gender, regex("^Male$", ignore_case = TRUE)) ~ 1, 
                      str_detect(gender, regex("Female", ignore_case = TRUE)) ~ 0, TRUE ~ NA_real_),
    un_sup_lic = (study_parent1 == ">BAC3" | study_parent2 == ">BAC3"),
    deux_supBAC = (study_parent1 %in% c("BAC1-3", ">BAC3") & study_parent2 %in% c("BAC1-3", ">BAC3")),
    mention_TB = (mention_bac == "TB"),
    mention_TBB = (mention_bac %in% c("TB", "B")),

    # --- INSTALLATION ---
    across(starts_with("installation_") & !contains("other"), 
           ~ case_when(as.numeric(.) <= 2 ~ 1, as.numeric(.) == 3 ~ 2, as.numeric(.) >= 4 ~ 3, TRUE ~ as.numeric(.)))
  )
# NOTE : J'ai supprimé le filter() final qui excluait les "Autre"

# Calcul des effectifs
N_counts <- df_analyse %>% count(groupe_etude)
# On récupère les effectifs pour l'affichage, y compris "Autre" si besoin
N_Total <- nrow(df_analyse)

# --- 3. GÉNÉRATION DES TABLEAUX ---

create_table_with_total <- function(data, vars, labels_map) {
  # 1. Stats par groupe
  stats_group <- data %>%
    filter(groupe_etude != "Autre") %>% # On affiche les groupes principaux
    select(groupe_etude, all_of(vars)) %>%
    pivot_longer(cols = -groupe_etude, names_to = "Variable", values_to = "Val") %>%
    group_by(Variable, groupe_etude) %>%
    summarise(Mean = mean(Val, na.rm = TRUE), SD = sd(Val, na.rm = TRUE)) %>%
    pivot_wider(names_from = groupe_etude, values_from = c(Mean, SD), names_glue = "{groupe_etude}_{.value}")
  
  # 2. Stats Total (Incluant les 5 "Autre")
  stats_total <- data %>%
    select(all_of(vars)) %>%
    pivot_longer(cols = everything(), names_to = "Variable", values_to = "Val") %>%
    group_by(Variable) %>%
    summarise(Total_Mean = mean(Val, na.rm = TRUE), Total_SD = sd(Val, na.rm = TRUE))
  
  # 3. Fusion
  left_join(stats_group, stats_total, by = "Variable") %>%
    mutate(Variable = factor(Variable, levels = vars, labels = labels_map)) %>%
    arrange(Variable) %>%
    select(Variable, 
           LAS_Mean, LAS_SD, 
           PACES_Mean, PACES_SD, 
           PASS_Mean, PASS_SD, 
           Passerelle_Mean, Passerelle_SD,
           Total_Mean, Total_SD) %>%
    flextable() %>%
    colformat_double(digits = 2) %>%
    set_header_labels(
      LAS_Mean = "Moy", LAS_SD = "SD",
      PACES_Mean = "Moy", PACES_SD = "SD",
      PASS_Mean = "Moy", PASS_SD = "SD",
      Passerelle_Mean = "Moy", Passerelle_SD = "SD",
      Total_Mean = "Moy", Total_SD = "SD"
    ) %>%
    add_header_row(
      values = c("", "LAS", "PACES", "PASS", "Passerelle", paste0("Total (N=", N_Total, ")")),
      colwidths = c(1, 2, 2, 2, 2, 2)
    ) %>%
    autofit()
}

# Variables Continues
vars_cont <- c("Score_JSE", "PT", "CC", "SPS", "stated_risk", "stated_altruism", 
               "stated_patience", "risk_health_other", "risk_self", "risk_else", 
               "altruist_cg", "pg")
t_cont <- create_table_with_total(df_analyse, vars_cont, vars_cont)

# Variables Binaires
vars_bin <- c("CG_conform", "Homme", "un_sup_lic", "deux_supBAC", "mention_TB", "mention_TBB")
t_bin <- create_table_with_total(df_analyse, vars_bin, vars_bin) %>% colformat_double(digits = 2)

# Variables Installation
vars_inst <- c("installation_reprise", "installation_proximite_famille", 
               "installation_proximite_etude", "installation_offre_soin", 
               "installation_famille", "installation_aides")
t_inst <- create_table_with_total(df_analyse, vars_inst, vars_inst)

