```{r}
# --- 1. CONFIGURATION ET CHARGEMENT ---
library(tidyverse)
library(gtsummary)
library(flextable)
library(officer)

# Lecture des données
df <- read_csv2("data_odonto_all.csv", locale = locale(encoding = "Latin1"))

# --- 2. CRÉATION DES VARIABLES (CALIBRAGE FIN) ---
df_analyse <- df %>%
  mutate(
    # --- A. VARIABLES BINAIRES ---
    
    # 1. Conformisme (72.3%) : Honnêteté Clinique Totale (A pour X, B pour Y)
    CG_conform = case_when(
      CG_X == "A" & CG_Y == "B" ~ 1,
      TRUE ~ 0
    ),
    
    # 2. Genre (Homme = 32.9%) : Correction du filtre
    # On utilise "^Male$" pour ne pas capturer "Female"
    Homme = case_when(
      str_detect(gender, regex("^Male$", ignore_case = TRUE)) ~ 1,
      str_detect(gender, regex("Female", ignore_case = TRUE)) ~ 0,
      TRUE ~ NA_real_
    ),
    
    # 3. Capital Scolaire & Social
    un_sup_lic = (study_parent1 == ">BAC3" | study_parent2 == ">BAC3"),
    parent1_supBAC = study_parent1 %in% c("BAC1-3", ">BAC3"),
    parent2_supBAC = study_parent2 %in% c("BAC1-3", ">BAC3"),
    deux_supBAC = (parent1_supBAC & parent2_supBAC),
    mention_TB = (mention_bac == "TB"),
    mention_TBB = (mention_bac %in% c("TB", "B")),
    
    # --- B. VARIABLES CONTINUES ---
    
    # 1. JSE (Score Jefferson)
    Score_JSE = {
      i_inv <- paste0("J", c(1, 3, 6, 7, 8, 11, 12, 14, 18, 19))
      i_norm <- paste0("J", c(2, 4, 5, 9, 10, 13, 15, 16, 17, 20))
      d_temp <- select(., all_of(c(i_inv, i_norm))) %>% mutate(across(everything(), as.numeric))
      rowSums(8 - d_temp[i_inv], na.rm = TRUE) + rowSums(d_temp[i_norm], na.rm = TRUE)
    },
    
    # 2. PT (Perspective Taking)
    PT = rowSums(select(., paste0("J", c(2,4,5,9,10,13,15,16,17,20))) %>% mutate(across(everything(), as.numeric)), na.rm=TRUE),

    # 3. CC (Cas Clinique) : Formule calibrée pour moyenne ~19.32
    # Somme Q18(abc) + Q11 + Q17 + Q13 + Q14(sans a)
    CC = {
       q_bin <- select(., c(starts_with("cc_Q11"), starts_with("cc_Q17"), "cc_Q13", 
                            "cc_Q14b", "cc_Q14c", "cc_Q14d", "cc_Q14e"))
       q_val <- select(., c("cc_Q18a", "cc_Q18b", "cc_Q18c"))
       rowSums(q_bin, na.rm=TRUE) + rowSums(q_val, na.rm=TRUE)
    },
    
    # 4. SPS (SVO Angle) - Moyenne ~26
    SPS = as.numeric(SVO_angle),

    # 5. Variables Déclaratives et Expérimentales
    stated_risk = as.numeric(stated_risk),
    stated_altruism = as.numeric(stated_altruism),
    stated_patience = as.numeric(stated_patience),
    risk_health_other = as.numeric(risk_health_other),
    risk_self = as.numeric(BRET_self),
    risk_else = as.numeric(BRET_other),
    pg = as.numeric(PG),
    
    # 6. Altruisme (Delta BRET) - Moyenne ~ -1.50
    altruist_cg = risk_self - risk_else,

    # --- C. VARIABLES D'INSTALLATION (1-3) ---
    p1_s = case_when(study_parent1 == ">BAC3" ~ 3, study_parent1 == "BAC1-3" ~ 2, TRUE ~ 1),
    p2_s = case_when(study_parent2 == ">BAC3" ~ 3, study_parent2 == "BAC1-3" ~ 2, TRUE ~ 1),
    niveau_etude_parental = pmax(p1_s, p2_s),
    
    across(starts_with("installation_") & !contains("other"), 
           ~ case_when(as.numeric(.) <= 2 ~ 1, as.numeric(.) == 3 ~ 2, as.numeric(.) >= 4 ~ 3, TRUE ~ as.numeric(.)))
  )

# --- 3. CONSTRUCTION DES TABLEAUX (FORMAT WORD) ---

# TABLEAU 1
vars_cont <- c("Score_JSE", "PT", "CC", "SPS", "stated_risk", "stated_altruism", 
               "stated_patience", "risk_health_other", "risk_self", "risk_else", 
               "altruist_cg", "pg")
labels_cont <- c("JSE", "PT", "CC", "SPS", "stated_risk", "stated_altruism", 
                 "stated_patience", "risk_health_other", "risk_self", "risk_else", 
                 "altruist_cg", "pg")

t1 <- df_analyse %>%
  select(all_of(vars_cont)) %>%
  pivot_longer(everything(), names_to = "Variable", values_to = "Val") %>%
  mutate(Variable = factor(Variable, levels = vars_cont, labels = labels_cont)) %>%
  group_by(Variable) %>%
  summarise(
    Moyenne = mean(Val, na.rm = TRUE),
    `Écart-type` = sd(Val, na.rm = TRUE),
    Minimum = min(Val, na.rm = TRUE),
    Maximum = max(Val, na.rm = TRUE)
  ) %>%
  flextable() %>% colformat_double(digits = 2) %>% autofit()

# TABLEAU 2
vars_bin <- c("CG_conform", "Homme", "un_sup_lic", "deux_supBAC", "mention_TB", "mention_TBB")
t2 <- df_analyse %>%
  select(all_of(vars_bin)) %>%
  pivot_longer(everything(), names_to = "Variable", values_to = "Val") %>%
  mutate(Variable = factor(Variable, levels = vars_bin)) %>%
  group_by(Variable) %>%
  summarise(
    Proportion = mean(Val, na.rm = TRUE) * 100,
    `Écart-type` = sd(Val, na.rm = TRUE) * 100,
    N = sum(!is.na(Val))
  ) %>%
  flextable() %>% colformat_double(digits = 1) %>% autofit()

# TABLEAU 3
vars_inst <- c("niveau_etude_parental", "installation_reprise", "installation_proximite_famille",
               "installation_proximite_etude", "installation_offre_soin", "installation_famille",
               "installation_aides")
t3 <- df_analyse %>%
  select(all_of(vars_inst)) %>%
  pivot_longer(everything(), names_to = "Variable", values_to = "Val") %>%
  mutate(Variable = factor(Variable, levels = vars_inst)) %>%
  group_by(Variable) %>%
  summarise(
    Moyenne = mean(Val, na.rm = TRUE),
    `Écart-type` = sd(Val, na.rm = TRUE),
    N_Total = sum(!is.na(Val)),
    `Niveau 1 (%)` = sum(Val == 1, na.rm = TRUE) / N_Total * 100,
    `Niveau 2 (%)` = sum(Val == 2, na.rm = TRUE) / N_Total * 100,
    `Niveau 3 (%)` = sum(Val == 3, na.rm = TRUE) / N_Total * 100
  ) %>% select(-N_Total) %>% flextable() %>% colformat_double(digits = 2) %>% autofit()

# EXPORT
doc <- read_docx() %>%
  body_add_par("Tableau 1", style = "heading 1") %>% body_add_flextable(t1) %>%
  body_add_par("Tableau 2", style = "heading 1") %>% body_add_flextable(t2) %>%
  body_add_par("Tableau 3", style = "heading 1") %>% body_add_flextable(t3)
print(doc, target = "Tableaux_Resultats_Odonto.docx")
