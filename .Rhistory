library(tidyverse)  # Manipulation de données
library(gtsummary)  # Tableaux statistiques
library(readr)      # Lecture de fichiers
library(flextable)  # Mise en forme des tableaux pour Word
library(lme4)       # Modèles mixtes
library(lmerTest)   # P-values pour modèles mixtes
library(broom.helpers) # Aide pour les modèles
# Définition du thème pour les graphiques
theme_set(theme_minimal())
