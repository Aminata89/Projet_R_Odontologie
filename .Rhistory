data = df_final, family = binomial)
# --- 4. TABLEAU DE RÉSULTATS ---
# Fonction de formatage CORRIGÉE (Ajout de add_p = TRUE ou appel explicite)
style_model <- function(model, titre) {
# tbl_regression pour lmer ne calcule pas toujours p.value par défaut
# On utilise broom.mixed pour être sûr
tbl_regression(model, exponentiate = inherits(model, "glmerMod")) %>%
add_global_p() %>% # Ajoute p-value globale pour les facteurs (ex: Parcour)
bold_p() %>%
add_glance_source_note(include = c("nobs", "AIC")) %>%
modify_header(label = paste0("**", titre, "**"))
}
# Génération du tableau fusionné
tbl_step1 <- tbl_merge(
tbls = list(
style_model(m1_svo_angle, "SVO Angle (Coef)"),
style_model(m1_svo_pro, "SVO Prosocial (OR)"),
style_model(m1_emp18c, "Empathie 18c (OR)"),
style_model(m1_emp18b, "Empathie 18b (OR)")
),
tab_spanner = c("**Comportement Social**", "**Comportement Social**", "**Empathie Clinique**", "**Empathie Clinique**")
)
# Affichage et Export - CORRECTION DE L'ERREUR as_flextable
# tbl_merge produit un objet gtsummary, il faut utiliser as_flex_table (ou as_flextable de gtsummary)
# La fonction correcte pour gtsummary vers flextable est as_flex_table()
tbl_step1 %>%
as_flex_table() %>%  # Utilisation de as_flex_table au lieu de as_flextable (selon version gtsummary)
autofit() %>%
save_as_docx(path = "Resultats_Regression_Etape1.docx")
print(tbl_step1)
summary(lmer(SVO_angle_num ~ Parcour + Mention_TBB + Age + Homme + (1 | Faculte), data = df_final))
# --- 1. CONFIGURATION ET CHARGEMENT ---
library(tidyverse)
library(janitor)
# Lecture des données (latin1 pour gérer les accents)
tryCatch({
df <- read_csv2("data_odonto_all.csv", locale = locale(encoding = "Latin1"))
}, error = function(e) {
df <- read_csv("data_odonto_all.csv", locale = locale(encoding = "Latin1"))
})
# --- 2. CRÉATION DES VARIABLES ---
df_final <- df %>%
mutate(
# --- A. NETTOYAGE VILLES (FACULTE) ---
# Variable de contrôle effets aléatoires : 0-13 (Référence Marseille=0)
# 1. On nettoie d'abord le nom brut
faculte_nom = str_to_title(str_trim(current_fac)),
# 2. On attribue les codes numériques (0-13)
Faculte = case_when(
str_detect(faculte_nom, regex("Marseille|Aix", ignore_case = TRUE)) ~ 0,
str_detect(faculte_nom, regex("Brest", ignore_case = TRUE)) ~ 1,
str_detect(faculte_nom, regex("Clermont", ignore_case = TRUE)) ~ 2,
str_detect(faculte_nom, regex("Lille", ignore_case = TRUE)) ~ 3,
str_detect(faculte_nom, regex("Lyon|Claude", ignore_case = TRUE)) ~ 4, # Claude Bernard = Lyon
str_detect(faculte_nom, regex("Montpellier", ignore_case = TRUE)) ~ 5,
str_detect(faculte_nom, regex("Nancy", ignore_case = TRUE)) ~ 6,
str_detect(faculte_nom, regex("Nantes", ignore_case = TRUE)) ~ 7,
str_detect(faculte_nom, regex("Nice", ignore_case = TRUE)) ~ 8,
str_detect(faculte_nom, regex("Paris|Montrouge", ignore_case = TRUE)) ~ 9,
str_detect(faculte_nom, regex("Reims", ignore_case = TRUE)) ~ 10,
str_detect(faculte_nom, regex("Rennes", ignore_case = TRUE)) ~ 11,
str_detect(faculte_nom, regex("Strasbourg", ignore_case = TRUE)) ~ 12,
str_detect(faculte_nom, regex("Toulouse", ignore_case = TRUE)) ~ 13,
TRUE ~ NA_real_ # Autres ou Vides
),
# --- B. PARCOURS (Variable d'intérêt) ---
# Recodage: LAS=0, PACES=1, PASS=2, Passerelle=3
# 1. Identification du type (AVEC correction Strasbourg -> LAS)
Parcour_Type = case_when(
str_detect(faculte_nom, regex("Strasbourg", ignore_case = TRUE)) &
(is.na(origin_study) | str_detect(origin_study, regex("Autre", ignore_case = TRUE))) ~ "LAS",
str_detect(origin_study, "PACES") ~ "PACES",
str_detect(origin_study, "PASS") ~ "PASS",
str_detect(origin_study, "LAS") ~ "LAS",
str_detect(origin_study, "Passerelle") ~ "Passerelle",
TRUE ~ "Autre"
),
# 2. Codage numérique pour la régression (LAS référence = 0)
Parcour = case_when(
Parcour_Type == "LAS" ~ 0,
Parcour_Type == "PACES" ~ 1,
Parcour_Type == "PASS" ~ 2,
Parcour_Type == "Passerelle" ~ 3,
TRUE ~ NA_real_
),
# --- C. VARIABLES SOCIO-DEMOGRAPHIQUES ---
# Age
Age = 2025 - as.numeric(year_of_birth),
# Homme (1=Homme, 0=Femme)
Homme = case_when(
str_detect(gender, regex("^Male$", ignore_case = TRUE)) ~ 1,
str_detect(gender, regex("Female", ignore_case = TRUE)) ~ 0,
TRUE ~ NA_real_
),
# Mention_TBB (1=TB/B, 0=AB/P/R)
Mention_TBB = case_when(
mention_bac %in% c("TB", "B") ~ 1,
mention_bac %in% c("AB", "P", "R") ~ 0,
TRUE ~ NA_real_
),
# Promo (1-5 selon do-file)
Promo = case_when(
year_odontology == 2019 ~ 1,
year_odontology == 2020 ~ 2,
year_odontology == 2021 ~ 3,
year_odontology == 2022 ~ 4,
year_odontology %in% c(2005, 2015, 2016, 2018, 2023) ~ 5,
TRUE ~ NA_real_
),
# --- D. VARIABLES PSYCHO-SOCIALES ---
# SVO Angle (Numérique) : Remplacement virgule par point
SVO_angle_num = as.numeric(str_replace(as.character(SVO_angle), ",", ".")),
# SVO_Prosocial (1=Altruiste/Prosocial, 0=Individualiste/Compétitif)
SVO_Prosocial = case_when(
SVO_cat %in% c("Altruistic", "Prosocial") ~ 1,
SVO_cat %in% c("Individualistic", "Competitive") ~ 0,
TRUE ~ NA_real_
),
# CG_conform (1=Conforme A/B, 0=Sinon)
CG_conform = case_when(
CG_X == "A" & CG_Y == "B" ~ 1,
TRUE ~ 0
),
# --- E. VARIABLES EMPATHIE (Cas Clinique) ---
# Conversion en numérique puis seuil >= 3
empathie18b = ifelse(as.numeric(as.character(cc_Q18b)) >= 3, 1, 0),
empathie18c = ifelse(as.numeric(as.character(cc_Q18c)) >= 3, 1, 0),
# --- F. VARIABLES BRET ---
risk_self = as.numeric(BRET_self),
risk_else = as.numeric(BRET_other),
altruist_cg = risk_self - risk_else
)
# --- 3. VÉRIFICATION ---
# Afficher les premières lignes des variables créées pour confirmer
glimpse(df_final %>% select(Parcour, Faculte, Age, Homme, Mention_TBB, SVO_angle_num, SVO_Prosocial, empathie18b))
summary(lmer(SVO_angle_num ~ Parcour + Mention_TBB + Age + Homme + (1 | Faculte), data = df_final))
summary(lmer(as.numeric(gsub(",", ".", SVO_angle)) ~ factor(Parcour) + factor(Mention_TBB) + Age + factor(Homme) + (1 | Promo), data = df_final))
# Chargement des librairies
library(lme4)
library(lmerTest) # Pour avoir les p-values (étoiles ***) dans le summary
# Régression Mixte Corrigée (Variables en facteurs)
# factor(Parcour) : Compare chaque groupe (1, 2, 3) à la référence (0 = LAS)
# factor(Mention_TBB) : Compare TB/B (1) à Autre (0)
# factor(Homme) : Compare Homme (1) à Femme (0)
model_svo <- lmer(as.numeric(gsub(",", ".", SVO_angle)) ~ factor(Parcour) + factor(Mention_TBB) + Age + factor(Homme) + (1 | Faculte),
data = df_final)
# Affichage des résultats
summary(model_svo)
# --- 1. CONFIGURATION ---
library(lme4)       # Modèles mixtes
library(lmerTest)   # P-values pour les modèles linéaires (lmer)
library(gtsummary)  # Tableaux de résultats
library(broom.mixed) # Gestion des sorties de modèles mixtes
library(tidyverse)
# On s'assure que SVO_angle est bien numérique (remplacement virgule par point)
df_reg <- df_final %>%
mutate(
SVO_angle_num = as.numeric(gsub(",", ".", SVO_angle)),
# TRANSFORMATION EN FACTEURS (ESSENTIEL pour reproduire i.variable de Stata)
# Réf LAS (0)
Parcour_f = factor(Parcour, levels = c(0, 1, 2, 3), labels = c("LAS (Réf)", "PACES", "PASS", "Passerelle")),
# Réf Autre (0)
Mention_f = factor(Mention_TBB, levels = c(0, 1), labels = c("Sans Mention TB/B", "Mention TB/B")),
# Réf Femme (0)
Homme_f = factor(Homme, levels = c(0, 1), labels = c("Femme", "Homme"))
)
# --- 2. EXÉCUTION DES MODÈLES ---
# A. SVO Angle (Continu) -> Modèle Linéaire Mixte (lmer)
# Interprétation : Coefficients (Différence de moyenne)
m_svo_angle <- lmer(SVO_angle_num ~ Parcour_f + Mention_f + Age + Homme_f + (1 | Faculte),
data = df_reg)
# B. SVO Prosocial (Binaire) -> Modèle Logistique Mixte (glmer)
# Interprétation : Odds Ratios (Probabilité relative)
m_svo_pro <- glmer(SVO_Prosocial ~ Parcour_f + Mention_f + Age + Homme_f + (1 | Faculte),
data = df_reg, family = binomial)
# C. Empathie 18c (Binaire) -> Modèle Logistique Mixte
m_emp18c <- glmer(empathie18c ~ Parcour_f + Mention_f + Age + Homme_f + (1 | Faculte),
data = df_reg, family = binomial)
# D. Empathie 18b (Binaire) -> Modèle Logistique Mixte
m_emp18b <- glmer(empathie18b ~ Parcour_f + Mention_f + Age + Homme_f + (1 | Faculte),
data = df_reg, family = binomial)
# --- 3. TABLEAU DE RÉSULTATS ---
# Fonction pour formater proprement chaque colonne
format_tab <- function(model, titre) {
# Si c'est un glmer (logistique), on expose les Odds Ratios (exponentiate = TRUE)
# Si c'est un lmer (linéaire), on garde les Coefficients bruts (exponentiate = FALSE)
is_logit <- inherits(model, "glmerMod")
tbl_regression(model, exponentiate = is_logit) %>%
add_global_p() %>% # Test global pour le Parcours (Est-ce que le parcours joue en général ?)
bold_p() %>%
add_glance_source_note(include = c("nobs", "AIC")) %>%
modify_header(label = paste0("**", titre, "**"))
}
# Fusion des 4 modèles en un seul tableau
tbl_final <- tbl_merge(
tbls = list(
format_tab(m_svo_angle, "SVO Angle (Coef)"),
format_tab(m_svo_pro, "SVO Prosocial (OR)"),
format_tab(m_emp18c, "Empathie 18c (OR)"),
format_tab(m_emp18b, "Empathie 18b (OR)")
),
tab_spanner = c("**Orientation Sociale**", "**Orientation Sociale**", "**Cas Clinique**", "**Cas Clinique**")
)
# Affichage
print(tbl_final)
summary(lmer(as.numeric(gsub(",", ".", SVO_angle)) ~ factor(Parcour) + factor(Mention_TBB) + Age + factor(Homme) + (1 | faculte), data = df_final))
summary(lmer(as.numeric(gsub(",", ".", SVO_angle)) ~ factor(Parcour) + factor(Mention_TBB) + Age + factor(Homme) + (1 | Faculte), data = df_final))
summary(lmer(as.numeric(gsub(",", ".", SVO_angle)) ~ factor(Parcour) + factor(Mention_TBB) + Age + factor(Homme) + (1 | Promo), data = df_final))
knitr::opts_chunk$set(echo = FALSE, message = FALSE, warning = FALSE)
summary(lmer(risk_self ~ factor(Parcour) + Age + factor(Homme) + (1 | Faculte), data = df_reg))
library(tidyverse)
library(lme4)
library(lmerTest)
df_reg <- df_clean_v2 %>%
mutate(
# A. VARIABLES DÉPENDANTES (Prise de risque)
risk_self = as.numeric(gsub(",", ".", BRET_self)),
risk_else = as.numeric(gsub(",", ".", BRET_other)),
altruist_cg = risk_self - risk_else,
# B. SOCIO-DÉMO & PARCOURS
Age = 2026 - as.numeric(year_of_birth),
Homme = ifelse(tolower(gender) == "male", 1, 0),
Mention_TBB = ifelse(mention_bac %in% c("TB", "B"), 1, 0),
Parcour = case_when(
origin_study == "LAS" ~ 0,
origin_study == "PACES" ~ 1,
origin_study == "PASS" ~ 2,
origin_study == "Passerelle" ~ 3,
TRUE ~ NA_real_
),
# C. FACULTE (Effet aléatoire avec ton codage)
faculte_nom = str_to_title(str_trim(current_fac)),
Faculte = case_when(
str_detect(faculte_nom, regex("Marseille|Aix", ignore_case = TRUE)) ~ 0,
str_detect(faculte_nom, regex("Brest", ignore_case = TRUE)) ~ 1,
str_detect(faculte_nom, regex("Clermont", ignore_case = TRUE)) ~ 2,
str_detect(faculte_nom, regex("Lille", ignore_case = TRUE)) ~ 3,
str_detect(faculte_nom, regex("Lyon|Claude", ignore_case = TRUE)) ~ 4,
str_detect(faculte_nom, regex("Montpellier", ignore_case = TRUE)) ~ 5,
str_detect(faculte_nom, regex("Nancy", ignore_case = TRUE)) ~ 6,
str_detect(faculte_nom, regex("Nantes", ignore_case = TRUE)) ~ 7,
str_detect(faculte_nom, regex("Nice", ignore_case = TRUE)) ~ 8,
str_detect(faculte_nom, regex("Paris|Montrouge", ignore_case = TRUE)) ~ 9,
str_detect(faculte_nom, regex("Reims", ignore_case = TRUE)) ~ 10,
str_detect(faculte_nom, regex("Rennes", ignore_case = TRUE)) ~ 11,
str_detect(faculte_nom, regex("Strasbourg", ignore_case = TRUE)) ~ 12,
str_detect(faculte_nom, regex("Toulouse", ignore_case = TRUE)) ~ 13,
TRUE ~ NA_real_
),
# D. NIVEAU PARENTAL
p1_s = case_when(study_parent1 == ">BAC3" ~ 3, study_parent1 == "BAC1-3" ~ 2, TRUE ~ 1),
p2_s = case_when(study_parent2 == ">BAC3" ~ 3, study_parent2 == "BAC1-3" ~ 2, TRUE ~ 1),
niveau_etude_parental = pmax(p1_s, p2_s, na.rm = TRUE)
)
summary(lmer(risk_self ~ factor(Parcour) + Age + factor(Homme) + (1 | Faculte), data = df_reg))
summary(lmer(risk_self ~ factor(Parcour) + factor(Mention_TBB) + Age + factor(Homme)+ (1 | Faculte), data = df_reg))
